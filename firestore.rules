rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ملفات المستخدمين: كل مستخدم يقرأ ويعدّل ملفه فقط
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.accountType in ['مالك', 'مستأجر'];

      // مسموح التعديل، لكن نوع الحساب لا يتغير بعد إنشائه
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.accountType == resource.data.accountType;

      allow delete: if false;
    }

    // العقارات: القراءة للجميع (مهم لظهورها في جوجل لاحقاً)،
    // والكتابة لصاحب العقار فقط
    match /properties/{propertyId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
